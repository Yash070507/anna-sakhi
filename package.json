{
  "name": "anna-sakhi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "server": "node server/index.js",
    "dev:full": "concurrently -n SERVER,VITE -c cyan,green \"npm run server\" \"npm run dev\"",
    "py:server": "python app.py",
    "py:dev:full": "concurrently -n PYSERVER,VITE -c magenta,green \"python app.py\" \"npm run dev\"",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "py:start": "npm run build && python app.py --prod",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.0"
  }
}
